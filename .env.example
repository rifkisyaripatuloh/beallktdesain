# Application
NODE_ENV=development
APP_NAME=TicketForge AI
APP_URL=http://localhost:3000

# MySQL 8+
DATABASE_URL="mysql://root:password@127.0.0.1:3306/ticketforge_ai"

# Generate strong random values; do not commit real secrets.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Ollama (future phase)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Object storage (future phase)
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=debug

